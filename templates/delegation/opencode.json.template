{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "node --check *": "allow",
      "python -m py_compile *": "allow",
      "python -m pytest *": "allow",
      "git status*": "allow",
      "git diff*": "allow"
    }
  }
}
